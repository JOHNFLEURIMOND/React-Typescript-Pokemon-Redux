{
  "name": "fullstackapp",
  "version": "1.0.0",
  "description": "Pokemon search application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"src/App.tsx\" \"src/main.tsx\" \"src/Store.ts\" \"src/styles.css\" \"src/vite-env.d.ts\" \"src/components/**/*.{ts,tsx}\" \"src/lib/**/*.ts\" \"src/pages/**/*.{ts,tsx}\" \"src/services/**/*.ts\" \"src/types/pokemon*.ts\" \"README.md\" \"docs/graphql-pokemon-research.md\" \"vite.config.ts\" \"postcss.config.cjs\" \"tailwind.config.cjs\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/App.tsx\" \"src/main.tsx\" \"src/Store.ts\" \"src/styles.css\" \"src/vite-env.d.ts\" \"src/components/**/*.{ts,tsx}\" \"src/lib/**/*.ts\" \"src/pages/**/*.{ts,tsx}\" \"src/services/**/*.ts\" \"src/types/pokemon*.ts\" \"README.md\" \"docs/graphql-pokemon-research.md\" \"vite.config.ts\" \"postcss.config.cjs\" \"tailwind.config.cjs\" \".github/workflows/*.yml\"",
    "ci": "npm run typecheck && npm run test:run && npm run build && npm run format:check"
  },
  "keywords": [
    "John",
    "Fleurimond"
  ],
  "author": "John Fleurimond",
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "moment": "2.29.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.7.0",
    "react-redux": "8.1.3",
    "react-router-dom": "5.2.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.18.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
